#!/data/data/com.termux/files/usr/bin/bash
# Termux:Boot autostart for Positive Vector (phone side).
# Hands off to the idempotent launcher, which keeps the CRM server and the
# protected web console alive. The Cloudflare connector runs on the PC relay.

export PATH=/data/data/com.termux/files/usr/bin:$PATH
export HOME=/data/data/com.termux/files/home

# Let the system and the other Termux:Boot scripts settle.
sleep 20

bash "$HOME/pv/launch-stack.sh"

echo "$(date -u +%Y-%m-%dT%H:%M:%SZ) boot: stack=$(pgrep -f 'pv/stack.sh' | tr '\n' ' ')" >> "$HOME/pv/boot.log"
