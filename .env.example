# Порт HTTP-сервера
PORT=3000

# Путь к файлу SQLite базы данных
DB_PATH=./data/pozitiv_vektor.sqlite

# Каталог хранения загруженных фотографий и документов
UPLOAD_DIR=./data/uploads

# Секрет подписи сессий (замените на случайную строку >= 32 символов в production)
SESSION_SECRET=replace_with_random_64_char_secret

# Установите true при работе строго по HTTPS за reverse proxy
COOKIE_SECURE=false

# Срок жизни сессии в часах
SESSION_TTL_HOURS=168

# Web Push: заполните собственными ключами (npx web-push generate-vapid-keys).
WEB_PUSH_PUBLIC_KEY=
WEB_PUSH_PRIVATE_KEY=
WEB_PUSH_SUBJECT=mailto:admin@example.com
